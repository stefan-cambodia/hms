{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HMS",
  "version": "0.1.0",
  "identifier": "app.hms.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "category": "Business",
    "shortDescription": "Hotel management system",
    "longDescription": "Desktop application of the HMS hotel management system. It connects to the hotel's HMS server and shows its interface; no data is stored on the computer except the server address.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "section": "misc" }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "French", "SimpChinese", "Russian"],
        "displayLanguageSelector": true
      }
    }
  }
}
