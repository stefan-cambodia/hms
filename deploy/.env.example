# --- Required secrets --------------------------------------------------------
# Database owner password, used only by migrations and backups
# (generate: openssl rand -hex 32)
POSTGRES_PASSWORD=
# Password of the API's own least-privilege database role `hms_api`
# (generate: openssl rand -hex 32). Created/updated automatically at start.
HMS_DB_APP_PASSWORD=
# Encryption key for stored secrets (OTA credentials, 2FA secrets, ID numbers).
# Generate: docker run --rm python:3.12-slim python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# BACK THIS KEY UP SEPARATELY: backups cannot decrypt these fields without it.
HMS_DATA_KEY=

# --- Site address and TLS ------------------------------------------------------
# In the hotel LAN: a local name with Caddy's internal CA (devices must trust it once):
HMS_SITE_ADDRESS=https://hms.lan
HMS_TLS=internal
# In the cloud with a public domain (automatic Let's Encrypt):
# HMS_SITE_ADDRESS=hotel.example.com
# HMS_TLS=you@example.com
HMS_HTTP_PORT=80
HMS_HTTPS_PORT=443

# --- Backups -------------------------------------------------------------------
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
# Point this at an external drive or a mounted network share for off-machine copies.
BACKUP_HOST_DIR=./backups

# --- Tuning --------------------------------------------------------------------
# API processes: about one per CPU core of the server (load test,
# docs/qa/phase10-report.md: 2 processes are the limit around 20 requests/s).
HMS_WORKERS=2
HMS_SESSION_IDLE_MINUTES=720
# Sign-in attempts per minute and per IP address (all API processes together).
# Cloud server: every device of a hotel may reach it through the hotel's single
# public address; raise this (for example 60) if a shift change hits the limit.
HMS_LOGIN_RATE_PER_MINUTE=20
HMS_ENABLE_DOCS=false
