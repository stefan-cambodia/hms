# HMS_SITE_ADDRESS examples:
#   hotel.example.com          public domain, automatic Let's Encrypt certificate
#   https://hms.lan            LAN name; with HMS_TLS=internal Caddy issues a local CA certificate
#   :80                        plain HTTP (only for testing behind another TLS proxy)
# HMS_TLS: "internal" (local CA) or your email address (Let's Encrypt account).
{
	servers {
		# Caddy is the edge: an X-Forwarded-For header sent by a client is
		# replaced, never trusted. Otherwise any device on the hotel network
		# could choose the address the API sees (login throttling, login
		# history, audit trail). Only behind another proxy, set
		# HMS_TRUSTED_PROXIES to that proxy's address range.
		trusted_proxies static {$HMS_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$HMS_SITE_ADDRESS::443} {
	tls {$HMS_TLS:internal}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Basic flood protection for the login endpoint is in the API; keep request bodies small.
	request_body {
		max_size 20MB
	}

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Request-ID {http.request.uuid}
		}
	}

	handle {
		root * /srv/frontend
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
